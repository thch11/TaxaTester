<Window x:Class="TaxaStation.BlackJackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaxaStation"
        mc:Ignorable="d"
        Title="WürtzJack" Height="725" Width="1200">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/Background.jpg" Stretch="Fill"/>
        </Grid.Background>

        <!-- DEALER PANEL -->
        <Label x:Name="NPCLabel" Content="DEALER:" Foreground="Yellow" HorizontalAlignment="Left" Margin="10,15,0,0" VerticalAlignment="Top" Width="168" Height="33" FontSize="20" FontWeight="Bold"/>
        <StackPanel x:Name="NPCPanel" 
                    Margin="10,48,10,0" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Height="210"/>

        <!-- PLAYER PANEL -->
        <Label x:Name="PlayerLabel" Content="PLAYER:" Foreground="Yellow" HorizontalAlignment="Left" Margin="10,296,0,0" VerticalAlignment="Top" Width="168" Height="33" FontSize="20" FontWeight="Bold"/>
        <StackPanel x:Name="PlayerPanel" 
                    Margin="10,329,10,0" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Height="210"/>

        <!-- CONTROLS & SCORES -->
        <Button x:Name="HitButton" Content="Hit" HorizontalAlignment="Left" Margin="10,552,0,0" VerticalAlignment="Top" Height="99" Width="120" FontSize="20" Click="HitButton_Click"/>
        <Button x:Name="StandButton" Content="Stand" HorizontalAlignment="Left" Margin="135,552,0,0" VerticalAlignment="Top" Height="99" Width="120" FontSize="20" Click="StandButton_Click"/>
        <Label x:Name="PointLabel" Content="Point: 10" Foreground="Red" HorizontalAlignment="Left" Margin="10,656,0,0" VerticalAlignment="Top" Height="36" Width="245" FontSize="20"/>
        <TextBlock x:Name="BustLabel" 
           Text="" 
           Foreground="Red" 
           HorizontalAlignment="Center" 
           VerticalAlignment="Top" 
           TextAlignment="Center"
           Margin="0,296,0,0" 
           Width="378" 
           Height="59" 
           FontSize="40" 
           FontWeight="Bold"/>
    </Grid>
</Window>